{
  "openapi": "3.1.0",
  "info": {"title": "Subactor Task API", "version": "0.2.0-draft", "description": "Draft kontraktu. Brak publicznego serwera. Read-only scope i katalog źródeł konfiguracji są federowane z subactor/config; API nie kopiuje sekretów ani authority."},
  "x-subactor-modules": {
    "config": {
      "contract": "repo://github.com/subactor/config/api/openapi.v1.json",
      "schema": "repo://github.com/subactor/config/schemas/system-config.v1.schema.json",
      "mode": "read-only-facade"
    }
  },
  "paths": {
    "/v1/tasks/catalog": {"post": {"operationId": "taskCatalog", "responses": {"200": {"description": "Catalog receipt"}}}},
    "/v1/tasks/plan": {"post": {"operationId": "taskPlan", "responses": {"200": {"description": "Plan without side effects"}}}},
    "/v1/tasks": {"post": {"operationId": "taskSubmit", "responses": {"202": {"description": "Accepted task"}, "403": {"description": "Policy or grant denied"}}}},
    "/v1/tasks/{request_id}": {"get": {"operationId": "taskStatus", "responses": {"200": {"description": "Task receipt"}}}},
    "/v1/receipts/{receipt_id}": {"get": {"operationId": "receiptGet", "responses": {"200": {"description": "Redacted receipt"}}}},
    "/v1/config/nodes/{node_id}/scopes": {
      "get": {
        "operationId": "configNodeScopes",
        "description": "Secret-free scope.code and declared scope.data from subactor/config. The projection is not a mutation grant.",
        "x-subactor-upstream": "/v1/nodes/{node_id}/scopes",
        "parameters": [{"name": "node_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Versioned node scope projection"}, "404": {"description": "Unknown node"}}
      }
    },
    "/v1/config/accounts/{provider}": {
      "get": {
        "operationId": "configAccountScope",
        "description": "Configured provider identity, declared code/data scope, normalized authentication state and secret-free settings locations.",
        "x-subactor-upstream": "/v1/accounts/{provider}",
        "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Versioned account scope projection"}, "404": {"description": "Unknown provider account"}}
      }
    },
    "/v1/config/sources": {
      "get": {
        "operationId": "configSources",
        "description": "Federated, secret-free configuration source catalog. Every source is evidence-only.",
        "x-subactor-upstream": "/v1/sources",
        "parameters": [{"name": "provides", "in": "query", "required": false, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Configuration sources and current-node availability"}, "400": {"description": "Invalid capability id"}}
      }
    },
    "/v1/config/sources/{source_id}": {
      "get": {
        "operationId": "configSource",
        "description": "One source with owners, capabilities, trust, locations and current-node availability.",
        "x-subactor-upstream": "/v1/sources/{source_id}",
        "parameters": [{"name": "source_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Configuration source"}, "404": {"description": "Unknown source"}}
      }
    },
    "/v1/config/capabilities": {
      "get": {
        "operationId": "configCapabilities",
        "description": "Declared mapping from system capabilities to configuration sources.",
        "x-subactor-upstream": "/v1/capabilities",
        "responses": {"200": {"description": "Capability index"}}
      }
    },
    "/v1/config/resolve": {
      "get": {
        "operationId": "configResolve",
        "description": "Resolve an exact need to all matching evidence sources without creating authority.",
        "x-subactor-upstream": "/v1/resolve",
        "parameters": [{"name": "need", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Configuration source resolution"}, "400": {"description": "Missing or invalid capability id"}}
      }
    }
  }
}
